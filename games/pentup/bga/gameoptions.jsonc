{
  // option ids should be between 100 and 199
  "100": {
    "name": "Variant",
    "values": {
      "1": {
        "name": "Standard",
        "description": "The player with the most tiles on the highest level wins. Ties go to the next level down."
      },
      "2": {
        "name": "Misère",
        "description": "(Ignored with Advanced scoring.) The player with the most tiles on the lowest level (the table) wins. Ties go to the next level up."
      }
    },
    "default": 1
  },
  "101": {
    "name": "Scoring (3 players)",
    "values": {
      "1": {
        "name": "Standard",
        "description": "Same as with 2 players: the most tiles on the highest level wins, ties go to the next level down."
      },
      "2": {
        "name": "Advanced",
        "description": "Each tile scores its level number (table = 1 point, second level = 2, ...). The highest total wins. The Misère variant is ignored."
      }
    },
    "default": 1,
    "displaycondition": [
      {
        "type": "minplayers",
        "value": 3
      }
    ]
  }
}
