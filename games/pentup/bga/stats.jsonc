{
    // Statistics for the table (ids 10 and up; every name used in PHP must be here)
    "table": {
        "turns_number": { "id": 10, "name": "Number of turns", "type": "int" },
        "levels": { "id": 11, "name": "Levels reached", "type": "int" }
    },

    // Statistics for each player
    "player": {
        "turns_number": { "id": 10, "name": "Number of turns", "type": "int" },
        "tiles_top_level": { "id": 11, "name": "Tiles on the top level", "type": "int" },
        "highest_placed": { "id": 12, "name": "Highest level used by a tile", "type": "int" }
    }
}
