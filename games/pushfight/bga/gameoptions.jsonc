{
  // Game options for Push Fight
  // See https://en.doc.boardgamearena.com/Options_and_preferences:_gameoptions.json,_gamepreferences.json
  "100": {
    "name": "Starting Setup",
    "values": {
      "1": {
        "name": "Standard Opening (Beginner)",
        "description": "Pieces start in standard tournament opening positions. Recommended for beginners and rapid play."
      },
      "2": {
        "name": "Free Placement (Pro Variant)",
        "description": "Starting with White, players position their 3 square King pieces and 2 round Pawn pieces on their side of the center line before turn 1.",
        "nobeginner": true
      }
    },
    "default": 1
  },
  "101": {
    "name": "First Player / White Team",
    "values": {
      "1": {
        "name": "Default (table order)",
        "description": "The first player in table order plays White (moves first). On a rematch with the same players the starting player alternates."
      },
      "2": {
        "name": "Table Creator",
        "description": "The table creator / host plays White (moves first)."
      },
      "3": {
        "name": "Opponent",
        "description": "The opponent / second player plays White (moves first)."
      }
    },
    "default": 1
  }
}