{
    "100": {
        "name": "Track Circuit",
        "values": {
            "1": {
                "name": "Circuit 1 (Standard with Shortcut & Loop)",
                "description": "The classic nestorgames GP circuit featuring the high-speed shortcut and looping crossover."
            },
            "2": {
                "name": "Circuit 2 (Triple Loop)",
                "description": "A technical circuit with three self-crossing loops. Cars cross the same square twice, so a bump there can push a car off its path."
            },
            "3": {
                "name": "Circuit 3 (Gate and Teleport)",
                "description": "A long circuit with a gate shortcut that opens and closes when a car stops on a gate switch, plus two teleport pads."
            }
        },
        "default": 1
    },
    "101": {
        "name": "Qualifying Round",
        "values": {
            "1": {
                "name": "Enabled",
                "description": "Each player rolls push-your-luck dice before the race to determine pit lane starting grid position."
            },
            "2": {
                "name": "Disabled",
                "description": "Standard table seating order determines starting grid positions."
            }
        },
        "default": 1
    },
    "102": {
        "name": "Race Length",
        "values": {
            "1": {
                "name": "1 Lap (Quick Sprint)",
                "description": "Fast single-lap dash."
            },
            "2": {
                "name": "2 Laps (Short)",
                "description": "Short tactical sprint."
            },
            "3": {
                "name": "3 Laps (Standard)",
                "description": "Official standard championship distance."
            }
        },
        "default": 3
    },
    "103": {
        "name": "Special Items & Hazards",
        "values": {
            "1": {
                "name": "Disabled (Classic)",
                "description": "Pure push-your-luck racing without weapons or hazards (recommended for beginners)."
            },
            "2": {
                "name": "Enabled (Arcade Battle GP)",
                "description": "Race with Rockets, Turbo Boosts, Wrenches, Mines, and Oil Spills!"
            }
        },
        "default": 1
    },
    "104": {
        "name": "Cars per Player (Fleet Size)",
        "values": {
            "1": {
                "name": "1 car per player (Standard Solo)",
                "description": "Standard individual race where each player controls 1 car."
            },
            "2": {
                "name": "2 cars per player (Team GP)",
                "description": "Each player controls a team of 2 cars. Teams score combined championship points."
            },
            "3": {
                "name": "3 cars per player (Team GP)",
                "description": "Each player controls a team of 3 cars (e.g. 6 cars total in 2-player games)."
            },
            "4": {
                "name": "4 cars per player (Team GP)",
                "description": "Each player controls a team of 4 cars (8 cars total in 2-player games)."
            }
        },
        "default": 1
    },
    "105": {
        "name": "Item placement",
        "values": {
            "1": {
                "name": "Random",
                "description": "Special items and oil spills are placed on random straight spaces (never corners) at the start of the race."
            },
            "2": {
                "name": "Fixed layout",
                "description": "Items always start on the same hand-picked straight spaces for the chosen circuit."
            }
        },
        "default": 1,
        "displaycondition": [
            {
                "type": "otheroption",
                "id": 103,
                "value": 2
            }
        ]
    },
    "106": {
        "name": "Track condition",
        "values": {
            "1": {
                "name": "Dry race",
                "description": "Normal conditions."
            },
            "2": {
                "name": "Wet race",
                "description": "4 oil spills start on the track exactly where the rulebook shows them for the chosen circuit (works with or without special items)."
            }
        },
        "default": 1
    },
    "107": {
        "name": "Additional special items",
        "values": {
            "1": {
                "name": "No",
                "description": "One set of special items: 2 mines, 2 rockets, 2 wrenches and 2 turbo boosts."
            },
            "2": {
                "name": "Yes (advanced rule)",
                "description": "A second set of special items is added: 4 mines, 4 rockets, 4 wrenches and 4 turbo boosts in total."
            }
        },
        "default": 1,
