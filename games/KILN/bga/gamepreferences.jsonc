{
  // user preferences ids should be between 100 and 199
  // See https://en.doc.boardgamearena.com/Options_and_preferences:_gameoptions.json,_gamepreferences.json for more details
  "100": {
    "name": "Colorblind support (symbols on tiles)",
    "values": {
      "1": {
        "name": "On",
        "cssPref": "kiln_cb_on"
      },
      "0": {
        "name": "Off",
        "cssPref": "kiln_cb_off"
      }
    },
    "default": 0
  },
  "101": {
    "name": "Sound effects",
    "values": {
      "1": {
        "name": "On",
        "cssPref": "kiln_sound_on"
      },
      "0": {
        "name": "Off",
        "cssPref": "kiln_sound_off"
      }
    },
    "default": 1
  },
  "102": {
    "name": "Confirm placement (touch screens)",
    "values": {
      "1": {
        "name": "Ask me first (tap, then Confirm)",
        "cssPref": "kiln_confirm_on"
      },
      "0": {
        "name": "Place on tap",
        "cssPref": "kiln_confirm_off"
      }
    },
    "default": 1
  },
  "103": {
    "name": "Tooltips",
    "values": {
      "1": { "name": "On", "cssPref": "kiln_tips_on" },
      "0": { "name": "Off", "cssPref": "kiln_tips_off" }
    },
    "default": 1
  },
  "104": {
    "name": "Confirm end of turn",
    "values": {
      "1": { "name": "Ask me first (press Confirm end of turn)", "cssPref": "kiln_endturn_ask" },
      "0": { "name": "End the turn automatically when nothing can be sold", "cssPref": "kiln_endturn_auto" }
    },
    "default": 1
  }
}
