{
    "100": {
        "name": "Occupied space above 25 extra turn",
        "values": {
            "1": {
                "name": "Disabled (Standard)",
                "description": "Landing on an occupied space does not grant an extra turn."
            },
            "2": {
                "name": "Enabled (Optional Variant)",
                "description": "Moving your scoring Martian to a space above 25 points that is occupied by another player's scoring Martian grants an extra turn if at least 1 unused die remains."
            }
        },
        "default": 1
    },
    "101": {
        "name": "Last flower extra turn",
        "values": {
            "1": {
                "name": "Enabled (Optional Variant)",
                "description": "Planting the last flower of any color across the entire garden grants an extra turn if at least 1 unused die remains."
            },
            "2": {
                "name": "Disabled",
                "description": "Planting the last flower of a color does not grant an extra turn."
            }
        },
        "default": 1
    },
    "102": {
        "name": "Peaks variant",
        "values": {
            "1": {
                "name": "Disabled (Standard)",
                "description": "Play without peaks on the Martian garden."
            },
            "2": {
                "name": "Enabled",
                "description": "Play with peaks (gray cones) placed on non-adjacent hexes. Peaks block movement and cannot be planted on or entered."
            }
        },
        "default": 1
    },
    "103": {
        "name": "Game mode",
        "values": {
            "1": {
                "name": "Competitive (Standard)",
                "description": "Players compete for the highest individual score."
            },
            "2": {
                "name": "Cooperative (2–5 players)",
                "description": "In this variant, the group score is the score of the lowest scoring Martian. Players work together to achieve the highest possible group score."
            }
        },
        "default": 1
    },
    "104": {
        "name": "2-Player Variant: 2 Gardeners per player",
        "values": {
            "1": {
                "name": "Disabled (1 Gardener each)",
                "description": "Each player controls 1 gardener on the board."
            },
            "2": {
                "name": "Enabled (2 Gardeners each)",
                "description": "In a 2-player game, each player controls 2 gardeners and chooses which one to move on their turn (ignored if 3+ players)."
            }
        },
        "default": 1,
        "displaycondition": [
            {
                "type": "maxplayers",
                "value": 2
            }
        ]
    }
}
