  "100": {
    "name": "Colorblind support",
    "values": {
      "1": { "name": "On", "cssPref": "hippos_cb_on" },
      "0": { "name": "Off", "cssPref": "hippos_cb_off" }
    },
    "default": 1
  },
  "101": {
    "name": "Sound effects",
    "values": {
      "1": { "name": "On" },
      "0": { "name": "Off" }
    },
    "default": 1
  }
}
