{
  // user preference ids should be between 100 and 199 (AGENTS.md: 100 colour-blind symbols, 101 sound, 102 confirmation, 103 coordinates)
  "100": {
    "name": "Colorblind support",
    "values": {
      "1": { "name": "On", "cssPref": "ftd_cb_on" },
      "0": { "name": "Off", "cssPref": "ftd_cb_off" }
    },
    "default": 0
  },
  "101": {
    "name": "Sound effects",
    "values": {
      "1": { "name": "On" },
      "0": { "name": "Off" }
    },
    "default": 1
  },
  "102": {
    "name": "Move confirmation",
    "values": {
      "1": { "name": "Enabled" },
      "0": { "name": "Disabled" }
    },
    "default": 1
