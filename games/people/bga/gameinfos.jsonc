/*
 * From this file, you can edit the various meta-information of your game.
 *
 * See documentation about this file here:
 * http://en.doc.boardgamearena.com/Game_meta-information:_gameinfos.inc.php
*/
{
    // Name of the game in English (will serve as the basis for translation)
    "game_name": "People",

    // Game publisher (use empty string if there is no publisher)
    "publisher": "nestorgames",

    // Url of game publisher website
    "publisher_website": "https://www.nestorgames.com",

    // Board Game Geek ID of the publisher
    "publisher_bgg_id": 9976,

    // Board game geek ID of the game. PROVISIONAL: taken from a BGG-sourced aggregator listing (BoardMatch 467193).
    // Verify on boardgamegeek.com before the publisher page is signed.
    "bgg_id": 467193,

    // Players configuration that can be played (ex: 2 to 4 players)
    "players": [2, 3, 4],

    // Suggest players to play with this number of players. Must be null if there is no such advice, or if there is only one possible player configuration.
    // NB: the automatic lobby will try first the lowest number of players if this is not specified. So you _have to_ specify this parameter if the lowest player number is not compatible with the default options.
    "suggest_player_number": null,

    // Discourage players to play with these numbers of players. Must be null if there is no such advice.
    "not_recommend_player_number": null,

    // Estimated game duration, in minutes (used only for the launch, afterward the real duration is computed)
    "estimated_duration": 40,

    // Time in second add to a player when "giveExtraTime" is called (speed profile = fast)
    "fast_additional_time": 30,

    // Time in second add to a player when "giveExtraTime" is called (speed profile = medium)
    "medium_additional_time": 40,

    // Time in second add to a player when "giveExtraTime" is called (speed profile = slow)
    "slow_additional_time": 50,

    // If you are using a tie breaker in your game (using "player_score_aux"), you must describe here
    // the formula used to compute "player_score_aux". This description will be used as a tooltip to explain
    // the tie breaker to the players.
    // Note: if you are NOT using any tie breaker, leave the empty string. Equal totals share the win (no tie-break in the rules).
    "tie_breaker_description": "",

    // If in the game, all losers are equal (no score to rank them or explicit in the rules that losers are not ranked between them), set this to true
    // The game end result will display "Winner" for the 1st player and "Loser" for all other players
    "losers_not_ranked": false,

    // Allow to rank solo games for games where it's the only available mode (ex: Orchard). Should be left to false for games where solo mode exists in addition to multiple players mode.
    "solo_mode_ranked": false,

    // Is this game cooperative (all players wins together or loose together)
    "is_coop": 0,

    // Language dependency. If false or not set, there is no language dependency. If true, all players at the table must speak the same language.
    "language_dependency": false,

    // Colors attributed to players
    "player_colors": ["d62b1f", "1f5fd6", "e0b81a", "2e8b3a"],

    // Favorite colors support : if set to "true", support attribution of favorite colors based on player's preferences (see reattributeColorsBasedOnPreferences PHP method)
    // Off: the factory colours are fixed by turn order (red, blue, yellow, green) and must stay that way.
    "favorite_colors_support": false,

    // When doing a rematch, the player order is swapped using a "rotation" so the starting player is not the same
    // If you want to disable this, set this to true
    "disable_player_order_swap_on_rematch": false,

    // Game interface width
    // See https://en.doc.boardgamearena.com/Your_game_mobile_version#Autoscale
    "game_interface_width": {
        // Smallest logical width at which the game remains usable.
        // Values below 320 are treated as 320. Default: 740.
        "min": 320
    },

    // Trigger an exception when PHP detect warnings.
    "exception_on_warning": true
}
